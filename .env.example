# ChartMind environment variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local. NEVER prefix secrets with NEXT_PUBLIC_.

# Your Gemini API key (server-side only — never exposed to the browser)
GEMINI_API_KEY=

# Gemini model used for vision + analysis.
# Examples: gemini-2.0-flash, gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.0-flash
