# ChartMind environment variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local. NEVER prefix secrets with NEXT_PUBLIC_.

# Your Gemini API key (server-side only — never exposed to the browser). REQUIRED.
GEMINI_API_KEY=

# Gemini model used for vision + analysis.
# Good current choices (Sept 2026): gemini-3.5-flash, gemini-3.8-flash,
# gemini-2.5-flash (retires Oct 16 2026), gemini-3.1-flash-lite.
# NOTE: Google retires model IDs regularly (gemini-2.0-flash died June 1 2026).
# If the model here is retired (404), overloaded (503) or rate-limited (429),
# ChartMind automatically retries and falls through the chain:
#   GEMINI_MODEL -> gemini-3.5-flash -> gemini-3.8-flash -> gemini-2.5-flash -> gemini-3.1-flash-lite
GEMINI_MODEL=gemini-3.5-flash

# OPTIONAL cross-provider fallback: if EVERY Gemini model above is down or
# overloaded and this key is set, ChartMind retries with OpenAI vision models
# (gpt-4o-mini, then gpt-4o). Leave empty to stay Gemini-only.
OPENAI_API_KEY=
